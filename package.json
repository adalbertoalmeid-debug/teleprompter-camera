{
  "name": "teleprompter-camera",
  "version": "1.0.0",
  "private": true,
  "description": "Teleprompter com câmera para Android: grava vídeo com o texto rolando por cima (o texto não aparece no vídeo)",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor \"#171B24\" --iconBackgroundColorDark \"#171B24\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0"
  }
}